# ─── Supabase (hosted project) ────────────────────────────────────────────────
# Project settings → API. Copy this file to .env and fill in real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key — safe to ship in the mobile app (RLS enforces access).
SUPABASE_ANON_KEY=

# Service-role key — SECRET. Used ONLY by ingest/ and Edge Functions.
# Never import this into apps/mobile or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Ingest ───────────────────────────────────────────────────────────────────
# Where the scraper writes its drops (relative to repo root).
KAPRAY_DROPS_DIR=scraper/drops

# ─── Mobile app (Expo) ─────────────────────────────────────────────────────────
# Expo reads EXPO_PUBLIC_* vars into the client bundle. Mirror the public values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
