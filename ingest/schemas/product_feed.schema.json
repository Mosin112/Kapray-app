{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapray.app/schemas/product_feed.schema.json",
  "title": "Kapray canonical product feed (scraper drop)",
  "description": "Matches the scraper's output (spec §5). One file per brand per run.",
  "type": "object",
  "required": ["brand_slug", "scraped_at", "currency", "products"],
  "additionalProperties": false,
  "properties": {
    "brand_slug": { "type": "string", "minLength": 1 },
    "scraped_at": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["external_id", "title", "product_url", "variants"],
      "additionalProperties": false,
      "properties": {
        "external_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "product_url": { "type": "string", "format": "uri" },
        "category": { "type": ["string", "null"] },
        "fabric": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "images": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "default": []
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["external_id", "price", "available"],
      "additionalProperties": false,
      "properties": {
        "external_id": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "price": { "type": "number", "minimum": 0 },
        "compare_at_price": { "type": ["number", "null"], "minimum": 0 },
        "available": { "type": "boolean" }
      }
    }
  }
}
