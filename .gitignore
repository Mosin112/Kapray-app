# ───────────────────────── Node / Expo (apps/mobile) ─────────────────────────
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*
.metro-health-check*

# Native build output (managed workflow regenerates these)
apps/mobile/ios/
apps/mobile/android/

# ───────────────────────────── Python (ingest, scraper) ──────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ───────────────────────────── Scraper runtime output ────────────────────────
# Drops & state are regenerated by the scraper; committed fixtures live in
# ingest/tests/fixtures/ instead.
scraper/drops/
scraper/state/
scraper/*.log

# ───────────────────────────────── Supabase ──────────────────────────────────
supabase/.branches/
supabase/.temp/

# ─────────────────────────────── Secrets / env ───────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────── Logs / misc ────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
coverage/

# ─────────────────────────────────── IDE / OS ────────────────────────────────
.DS_Store
.vscode/
.idea/

# Native signing / secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
